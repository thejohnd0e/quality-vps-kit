#!/usr/bin/env bash
# qvk — quality-vps-kit standalone VPS tester (read-only).
# Intended to run as root on a fresh Debian/Ubuntu VPS right after SSH login.
# See README.md and docs/architecture.md.

set -uo pipefail

if ((BASH_VERSINFO[0] < 4)); then
  printf 'qvk: bash %s is too old; bash >= 4.4 is required\n' "$BASH_VERSION" >&2
  exit 2
fi

QVK_ROOT=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)
QVK_LIB="$QVK_ROOT/lib"

# shellcheck source=lib/common.sh
source "$QVK_LIB/common.sh"
# shellcheck source=lib/json.sh
source "$QVK_LIB/json.sh"
# shellcheck source=lib/i18n.sh
source "$QVK_LIB/i18n.sh"
# shellcheck source=lib/platform.sh
source "$QVK_LIB/platform.sh"
# shellcheck source=lib/redact.sh
source "$QVK_LIB/redact.sh"
# shellcheck source=lib/tests.sh
source "$QVK_LIB/tests.sh"
# shellcheck source=lib/inventory.sh
source "$QVK_LIB/inventory.sh"
# shellcheck source=lib/readiness.sh
source "$QVK_LIB/readiness.sh"
# shellcheck source=lib/net.sh
source "$QVK_LIB/net.sh"
# shellcheck source=lib/egress.sh
source "$QVK_LIB/egress.sh"
# shellcheck source=lib/diag.sh
source "$QVK_LIB/diag.sh"
# shellcheck source=lib/intel.sh
source "$QVK_LIB/intel.sh"
# shellcheck source=lib/httpcheck.sh
source "$QVK_LIB/httpcheck.sh"
# shellcheck source=lib/servicegeo.sh
source "$QVK_LIB/servicegeo.sh"
# shellcheck source=lib/speedtest.sh
source "$QVK_LIB/speedtest.sh"
# shellcheck source=lib/verdict.sh
source "$QVK_LIB/verdict.sh"
# shellcheck source=lib/report.sh
source "$QVK_LIB/report.sh"

QVK_VERSION="unknown"
if [[ -r $QVK_ROOT/VERSION ]]; then
  read -r QVK_VERSION <"$QVK_ROOT/VERSION" || QVK_VERSION="unknown"
fi

usage_error() {
  qvk_log "$(msg "$@")"
  exit "$QVK_EXIT_USAGE"
}

# Find --lang before full parsing so that early errors are localized too.
prescan_lang() {
  local lang="" prev="" arg
  for arg in "$@"; do
    case $arg in
      --lang=*) lang=${arg#--lang=} ;;
      *) [[ $prev == --lang ]] && lang=$arg ;;
    esac
    prev=$arg
  done
  case $lang in
    "" | en) qvk_set_lang "$lang" ;;
    *)
      qvk_set_lang ""
      usage_error err.bad_value --lang "$lang" "en"
      ;;
  esac
}

cmd_help() {
  msg usage
  printf '\n'
}

cmd_version() {
  printf 'qvk (quality-vps-kit) %s\n' "$QVK_VERSION"
}

# --- doctor ------------------------------------------------------------------

_doctor_row() {
  printf '  %s %s\n' "$(qvk_pad "$1" 22)" "$2"
}

cmd_doctor() {
  while (($#)); do
    case $1 in
      --lang) shift ;;
      --lang=*) ;;
      -h | --help)
        cmd_help
        return 0
        ;;
      *) usage_error err.unknown_option doctor "$1" ;;
    esac
    shift
  done

  local ready=1 os_label arch t path missing=() pkgs=()

  printf '%s\n\n' "$(qvk_paint bold "$(msg doctor.title quality-vps-kit "$QVK_VERSION")")"
  printf '%s\n' "$(msg doctor.section.platform)"

  if qvk_read_os_release; then
    os_label=${QVK_OS_PRETTY:-$QVK_OS_ID $QVK_OS_VERSION_ID}
    if qvk_os_supported; then
      _doctor_row "$(msg doctor.os)" "$os_label: $(qvk_paint green "$(msg doctor.supported)")"
    else
      ready=0
      _doctor_row "$(msg doctor.os)" "$os_label: $(qvk_paint red "$(msg doctor.unsupported)")"
    fi
  else
    ready=0
    _doctor_row "$(msg doctor.os)" "$(qvk_paint red "$(msg doctor.unknown_os)")"
  fi

  arch=$(qvk_arch)
  if qvk_arch_supported; then
    _doctor_row "$(msg doctor.arch)" "$arch: $(qvk_paint green "$(msg doctor.supported)")"
  else
    ready=0
    _doctor_row "$(msg doctor.arch)" "$arch: $(qvk_paint red "$(msg doctor.unsupported)")"
  fi

  if qvk_bash_ok; then
    _doctor_row "$(msg doctor.bash)" "$BASH_VERSION"
  else
    ready=0
    _doctor_row "$(msg doctor.bash)" "$BASH_VERSION: $(qvk_paint red "$(msg doctor.bash_old)")"
  fi

  if qvk_is_root; then
    _doctor_row "$(msg doctor.privileges)" "$(qvk_paint green "$(msg doctor.root)")"
  else
    _doctor_row "$(msg doctor.privileges)" "$(qvk_paint yellow "$(msg doctor.not_root "$(qvk_euid)")")"
  fi

  printf '\n%s\n' "$(msg doctor.section.required)"
  for t in "${QVK_REQUIRED_TOOLS[@]}"; do
    if path=$(command -v "$t" 2>/dev/null); then
      _doctor_row "$t" "$(qvk_paint green "$(msg doctor.found)")  $path"
    else
      ready=0
      missing+=("$t")
      _doctor_row "$t" "$(qvk_paint red "$(msg doctor.missing)")"
    fi
  done

  printf '\n%s\n' "$(msg doctor.section.optional)"
  for t in "${QVK_OPTIONAL_TOOLS[@]}"; do
    if path=$(command -v "$t" 2>/dev/null); then
      _doctor_row "$t" "$(qvk_paint green "$(msg doctor.found)")  $path"
    else
      _doctor_row "$t" "$(qvk_paint yellow "$(msg doctor.missing)")  ($(msg "opt.$t"))"
    fi
  done

  printf '\n%s\n' "$(msg doctor.section.devices)"
  if qvk_tun_present; then
    _doctor_row /dev/net/tun "$(qvk_paint green "$(msg doctor.tun_present)")"
  else
    _doctor_row /dev/net/tun "$(qvk_paint yellow "$(msg doctor.tun_absent)")"
  fi

  printf '\n'
  if ((${#missing[@]})); then
    for t in "${missing[@]}"; do pkgs+=("$(qvk_tool_package "$t")"); done
    printf '%s\n\n' "$(msg doctor.install_hint "$(printf '%s\n' "${pkgs[@]}" | sort -u | tr '\n' ' ' | sed 's/ $//')")"
  fi

  if ((ready == 0)); then
    printf '%s\n' "$(qvk_paint red "$(msg doctor.not_ready)")"
    return "$QVK_EXIT_ENV"
  fi
  if qvk_is_root; then
    printf '%s\n' "$(qvk_paint green "$(msg doctor.ready)")"
  else
    printf '%s\n' "$(qvk_paint yellow "$(msg doctor.ready_need_root)")"
  fi
  return "$QVK_EXIT_OK"
}

# --- run ---------------------------------------------------------------------

cmd_run() {
  local profile=quick format="" output="" output_set=0 load=1 v
  local endpoints="$QVK_ROOT/config/endpoints.tsv"
  while (($#)); do
    case $1 in
      --profile | --format | --output | --lang | --max-traffic-mb | --endpoints)
        (($# >= 2)) || usage_error err.missing_value "$1"
        v=$2
        case $1 in
          --profile) profile=$v ;;
          --format) format=$v ;;
          --output) output=$v output_set=1 ;;
          --endpoints) endpoints=$v ;;
          --max-traffic-mb) usage_error err.max_traffic_not_implemented ;;
        esac
        shift
        ;;
      --profile=*) profile=${1#*=} ;;
      --format=*) format=${1#*=} ;;
      --output=*) output=${1#*=} output_set=1 ;;
      --endpoints=*) endpoints=${1#*=} ;;
      --lang=*) ;;
      --max-traffic-mb=*) usage_error err.max_traffic_not_implemented ;;
      --offline) QVK_OFFLINE=1 ;;
      --redact-ip) QVK_REDACT=1 ;;
      --allow-load) load=1 ;;
      -h | --help)
        cmd_help
        return 0
        ;;
      *) usage_error err.unknown_option run "$1" ;;
    esac
    shift
  done

  case $profile in
    quick | full) ;;
    *) usage_error err.bad_value --profile "$profile" "quick|full" ;;
  esac
  if [[ -z $format ]]; then
    if [[ -n $output ]]; then format=json; else format=human; fi
  fi
  case $format in
    human | json) ;;
    *) usage_error err.bad_value --format "$format" "human|json" ;;
  esac
  if ((output_set)) && [[ -z $output ]]; then
    usage_error err.missing_value --output
  fi
  qvk_load_endpoints "$endpoints" || usage_error err.endpoints "$QVK_EP_ERROR"

  # Environment checks: exit 2.
  if ! qvk_is_root; then
    qvk_die "$QVK_EXIT_ENV" "$(msg err.not_root "$(qvk_euid)")"
  fi
  qvk_bash_ok || qvk_die "$QVK_EXIT_ENV" "$(msg err.bash_too_old "$BASH_VERSION")"
  qvk_read_os_release || true
  if ! qvk_os_supported || ! qvk_arch_supported; then
    qvk_die "$QVK_EXIT_ENV" "$(msg err.unsupported_platform "$(qvk_platform_label)")"
  fi
  local missing
  missing=$(qvk_missing_required | tr '\n' ' ' | sed 's/ $//')
  [[ -z $missing ]] || qvk_die "$QVK_EXIT_ENV" "$(msg err.missing_required "$missing")"

  qvk_install_traps
  qvk_tmpdir >/dev/null # create once in this shell so that cleanup knows it
  QVK_PROFILE=$profile
  QVK_LOAD_TEST_ENABLED=$load
  QVK_RUN_ID=$(qvk_new_run_id)
  QVK_STARTED_AT=$(qvk_now_utc)

  qvk_progress "$(msg progress.inventory)"
  qvk_inventory_collect
  qvk_readiness_evaluate
  qvk_egress_run
  qvk_diag_run
  qvk_intel_run
  qvk_progress "$(msg progress.http)"
  qvk_http_run
  qvk_progress "$(msg progress.service_geo)"
  qvk_service_geo_run
  if ((load)); then
    qvk_progress "$(msg progress.throughput)"
    qvk_speedtest_run
  fi
  qvk_geo_consensus
  qvk_claude_risk_evaluate
  qvk_verdict_evaluate
  qvk_progress_stop

  QVK_FINISHED_AT=$(qvk_now_utc)

  if [[ -n $output ]]; then
    QVK_COLOR=0
    # qvk_write_file runs in a pipeline subshell: propagate its exit status.
    if [[ $format == json ]]; then
      qvk_report_json | qvk_write_file "$output" || exit $?
    else
      qvk_report_human | qvk_write_file "$output" || exit $?
    fi
    qvk_log "$(msg report.saved "$output")"
  elif [[ $format == json ]]; then
    qvk_report_json
  else
    qvk_report_human
  fi
  return "$QVK_EXIT_OK"
}

# --- main --------------------------------------------------------------------

main() {
  qvk_init_env
  qvk_i18n_load
  prescan_lang "$@"
  qvk_color_init

  # Allow a global --lang before the command: `qvk --lang ru doctor`.
  while (($#)); do
    case $1 in
      --lang) shift 2 || shift ;;
      --lang=*) shift ;;
      *) break ;;
    esac
  done

  local cmd=${1:-help}
  if (($#)); then shift; fi
  case $cmd in
    help | -h | --help) cmd_help ;;
    version | --version) cmd_version ;;
    doctor) cmd_doctor "$@" ;;
    run) cmd_run "$@" ;;
    *) usage_error err.unknown_command "$cmd" ;;
  esac
}

main "$@"
